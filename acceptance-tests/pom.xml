<?xml version="1.0" encoding="UTF-8"?>
<!--
    PRUEBAS DE ACEPTACIÓN (Karate) - módulo independiente.

    No depende del código de la API: la prueba como una caja negra, por HTTP,
    igual que lo haría un cliente real. Por eso vive en su propia carpeta y su propio pom.

    Ejecutar contra una API ya levantada:
        mvn -f acceptance-tests/pom.xml test -Dkarate.env=local
        mvn -f acceptance-tests/pom.xml test -Dkarate.env=ci -DbaseUrl=http://localhost:8080 -DexpectedVersion=1.2.0
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.calidad</groupId>
    <artifactId>tareas-api-acceptance-tests</artifactId>
    <version>1.0.0</version>
    <name>tareas-api acceptance tests (Karate)</name>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <karate.version>1.5.2</karate.version>
        <surefire.version>3.5.4</surefire.version>
        <karate.env>local</karate.env>
        <baseUrl/>
        <expectedVersion/>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.karatelabs</groupId>
            <artifactId>karate-junit5</artifactId>
            <version>${karate.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Los .feature y karate-config.js viven junto a los runners Java -->
        <testResources>
            <testResource>
                <directory>src/test/java</directory>
                <excludes><exclude>**/*.java</exclude></excludes>
            </testResource>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <includes><include>**/*Runner.java</include></includes>
                    <systemPropertyVariables>
                        <karate.env>${karate.env}</karate.env>
                        <baseUrl>${baseUrl}</baseUrl>
                        <expectedVersion>${expectedVersion}</expectedVersion>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
